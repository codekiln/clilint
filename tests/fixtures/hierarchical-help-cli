#!/usr/bin/env python3
import json
import os
import sys

PATHS = {
    (): ["repo"],
    ("repo",): ["clone"],
    ("repo", "clone"): [],
}


def document(path):
    label = " ".join(("fixture",) + path)
    return (
        f"# {label}\n\n"
        f"Use {label} to exercise hierarchical help.\n\n"
        "## Usage\n\n"
        f"`{label} help`\n\n"
        "## Permissions\n\n"
        "This fixture has no side effects and needs no permissions.\n"
    )


def programmatic_document(path):
    return document(path) + (
        "\n## Programmatic use\n\n"
        "Request JSON with `--format json`, use `help outline`, then retrieve only "
        "the needed section with `help section <section>`. Output can be piped "
        "without a pager, animation, or full-screen interface.\n"
    )


def headings(programmatic):
    result = [
        {"level": 1, "title": "Fixture", "section": "fixture"},
        {"level": 2, "title": "Usage", "section": "usage"},
        {"level": 2, "title": "Permissions", "section": "permissions"},
        {"level": 2, "title": "More usage", "section": "usage"},
    ]
    if programmatic:
        result.append(
            {
                "level": 2,
                "title": "Programmatic use",
                "section": "programmatic-use",
            }
        )
    return result


def response(path, programmatic, **values):
    return {
        "format_version": 1,
        "command_path": list(path),
        "programmatic": programmatic,
        **values,
    }


def fail_for(path, operation):
    requested = os.environ.get("HIERARCHICAL_HELP_FAIL")
    key = "-".join(path) or "root"
    return requested in {key, f"{key}:{operation}"}


def write_json(value):
    if os.environ.get("HIERARCHICAL_HELP_MALFORMED") == "1":
        print("{not-json")
        return
    if os.environ.get("HIERARCHICAL_HELP_WRONG_PATH") == "1":
        value["command_path"] = ["not", "the", "requested", "path"]
    print(json.dumps(value, separators=(",", ":")))


def main():
    args = sys.argv[1:]
    if args in (["--version"], ["-V"]):
        print("hierarchical-help-fixture 1.2.3")
        return 0
    if args in ([],):
        print(document(()), end="")
        return 0
    if args in (["-h"],):
        print(document(()), end="")
        return 0
    if args and args[0].startswith("-") and args[0] not in {"--help"}:
        print(f"error: unknown option {args[0]}; try --help", file=sys.stderr)
        return 2

    if "--help" in args:
        index = args.index("--help")
        path = tuple(args[:index])
        if path not in PATHS:
            print("error: unknown command path", file=sys.stderr)
            return 2
        print(document(path), end="")
        return 0

    if "help" not in args:
        print("error: expected help; try --help", file=sys.stderr)
        return 2
    index = args.index("help")
    path = tuple(args[:index])
    rest = args[index + 1 :]
    if path not in PATHS:
        print("error: unknown command path", file=sys.stderr)
        return 2
    if os.environ.get("CLILINT_OFFLINE") != "1":
        print("error: hierarchical help checker did not request offline behavior", file=sys.stderr)
        return 4
    programmatic = "--programmatic" in rest
    json_format = "--format" in rest and rest[rest.index("--format") + 1] == "json"
    operation = rest[0] if rest and not rest[0].startswith("-") else "overview"

    if fail_for(path, operation):
        print(f"error: deliberate {operation} failure at {' '.join(path) or 'root'}", file=sys.stderr)
        return 3

    if operation == "outline":
        selected_headings = headings(programmatic)
        if os.environ.get("HIERARCHICAL_HELP_INVALID_HEADING") == "1":
            selected_headings.append(
                {"level": 7, "title": "Invalid", "section": "must-not-be-requested"}
            )
        if "--level" in rest:
            level = int(rest[rest.index("--level") + 1])
            selected_headings = [
                heading for heading in selected_headings if heading["level"] == level
            ]
        if "--max-level" in rest:
            level = int(rest[rest.index("--max-level") + 1])
            selected_headings = [
                heading for heading in selected_headings if heading["level"] <= level
            ]
        if json_format:
            write_json(response(path, programmatic, headings=selected_headings))
        else:
            for heading in selected_headings:
                print(f"{heading['level']} {heading['section']} {heading['title']}")
        return 0

    if operation == "section":
        if len(rest) < 2:
            print("error: section is required", file=sys.stderr)
            return 2
        section = rest[1]
        all_headings = headings(programmatic)
        matches = [heading for heading in all_headings if heading["section"] == section]
        if not matches:
            print(f"error: invalid section {section}", file=sys.stderr)
            return 2
        selected = list(matches)
        if "--recursive" in rest:
            for match_value in matches:
                index = all_headings.index(match_value)
                for descendant in all_headings[index + 1 :]:
                    if descendant["level"] <= match_value["level"]:
                        break
                    selected.append(descendant)
        sections = [
            {
                **heading,
                "content": {
                    "fixture": "Use this fixture to exercise hierarchical help.",
                    "usage": f"`{' '.join(('fixture',) + path)} help`",
                    "permissions": "No side effects or permissions.",
                    "programmatic-use": "Use JSON, outline, section, and pipes without a pager.",
                }[section],
            }
            for heading in selected
        ]
        if json_format:
            write_json(response(path, programmatic, sections=sections))
        else:
            for section_value in sections:
                print(f"{'#' * section_value['level']} {section_value['title']}\n")
                print(section_value["content"])
        return 0

    if operation == "search":
        query = rest[1] if len(rest) > 1 else ""
        results = []
        for command_path in PATHS:
            if command_path[: len(path)] != path:
                continue
            for heading in headings(programmatic):
                if query.lower() in (heading["title"] + " help").lower():
                    results.append(
                        {
                            "command_path": list(command_path),
                            "section": heading["section"],
                            "title": heading["title"],
                        }
                    )
        if json_format:
            write_json(response(path, programmatic, results=results))
        else:
            for result in results:
                print(" ".join(result["command_path"]), result["section"], result["title"])
        return 0

    if operation == "view":
        if "--web" in rest:
            slug = "/".join(path) if path else "index"
            print(f"https://example.test/hierarchical-help-fixture/1.2.3/{slug}")
        else:
            print(programmatic_document(path) if programmatic else document(path), end="")
        return 0

    if json_format:
        write_json(
            response(
                path,
                programmatic,
                child_commands=[{"name": name} for name in PATHS[path]],
            )
        )
    else:
        print(programmatic_document(path) if programmatic else document(path), end="")
    return 0


raise SystemExit(main())
